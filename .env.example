# ==============================================================================
# WearWise — Environment Configuration
# ==============================================================================
# Copy this file to .env or .env.local and populate with your Supabase credentials:
# 1. Sign up at https://supabase.com
# 2. Go to Project Settings -> API
# 3. Copy Project URL and Anon/Public Key

EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key-here
